---
const currentYear = new Date().getFullYear();
---

<footer class="ark-footer">
  <div class="container ark-footer-container">
    <div class="ark-footer-info">
      <div class="ark-footer-brand">
        <span class="ark-brand-icon">◈</span>
        <span class="ark-footer-title">TACTICAL OPERATIONS TERMINAL</span>
      </div>
      <p class="ark-footer-desc">
        Personal Engineering Dossier of Zander Rhoi Villanueva. Engineered for low-latency transmission, 
        accessible information architecture, and technical clarity.
      </p>
    </div>

    <div class="ark-footer-links">
      <span class="ark-footer-head">COMMUNICATION CHANNELS</span>
      <div class="ark-footer-socials">
        <a href="mailto:zhandercv@gmail.com" class="ark-social-btn" title="Direct Email Transmission">
          <i class="fa-solid fa-envelope"></i>
          <span>EMAIL TRANSMISSION</span>
        </a>
        <a href="https://github.com/ZanderOgayu" target="_blank" rel="noopener noreferrer" class="ark-social-btn" title="GitHub Codebase">
          <i class="fa-brands fa-github"></i>
          <span>GITHUB</span>
        </a>
        <a href="https://www.facebook.com/zander.villanueva.59114" target="_blank" rel="noopener noreferrer" class="ark-social-btn" title="Facebook">
          <i class="fa-brands fa-facebook-f"></i>
          <span>FACEBOOK</span>
        </a>
      </div>
    </div>
  </div>

  <div class="ark-footer-bottom">
    <div class="container ark-footer-bottom-inner">
      <span class="ark-copyright">
        // PROTOCOL 2026 // © {currentYear} ZANDER RHOI VILLANUEVA. ALL RIGHTS RESERVED.
      </span>
      <span class="ark-security-tag">
        SYS_STATUS: ACTIVE // DEPLOYED VIA VERCEL EDGE
      </span>
    </div>
  </div>
</footer>

<style>
  .ark-footer {
    margin-top: auto;
    background: var(--ark-bg-surface);
    border-top: 2px solid var(--ark-border-mid);
    padding-top: 48px;
    position: relative;
  }

  .ark-footer::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--ark-hazard-stripes);
  }

  .ark-footer-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }

  .ark-footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .ark-footer-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--ark-text-bright);
  }

  .ark-footer-desc {
    font-size: 0.88rem;
    color: var(--ark-text-body);
    max-width: 520px;
    line-height: 1.6;
  }

  .ark-footer-links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ark-footer-head {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ark-yellow);
    letter-spacing: 0.1em;
  }

  .ark-footer-socials {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ark-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: var(--ark-bg-card);
    border: 1px solid var(--ark-border-subtle);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ark-text-body);
    transition: var(--ark-transition);
  }

  .ark-social-btn:hover {
    color: var(--ark-yellow);
    border-color: var(--ark-yellow);
    background: var(--ark-yellow-dim);
    transform: translateX(4px);
  }

  .ark-footer-bottom {
    background: var(--ark-bg-base);
    border-top: 1px solid var(--ark-border-subtle);
    padding: 16px 0;
  }

  .ark-footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ark-copyright, .ark-security-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ark-text-muted);
    letter-spacing: 0.06em;
  }

  @media (max-width: 768px) {
    .ark-footer-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
