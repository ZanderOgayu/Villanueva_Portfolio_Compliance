<script>
  const modal = document.getElementById('ark-preview-modal');
  const closeBtn = document.getElementById('ark-modal-close-btn');
  const modalTitle = document.getElementById('ark-modal-doc-title');
  const modalDesc = document.getElementById('ark-modal-doc-desc');
  const modalIframe = document.getElementById('ark-modal-iframe') as HTMLIFrameElement;
  const modalImg = document.getElementById('ark-modal-img') as HTMLImageElement;
  const modalDtr = document.getElementById('ark-modal-dtr-table');
  const previewBtns = document.querySelectorAll('.js-preview-btn');
  const dtrBtn = document.querySelector('.js-dtr-preview-btn');

  function openPreview(title: string, file: string, desc: string, isImg: boolean, isDtr = false) {
    if (!modal) return;
    if (modalTitle) modalTitle.textContent = title;
    if (modalDesc) modalDesc.textContent = desc;

    if (isDtr) {
      if (modalIframe) modalIframe.style.display = 'none';
      if (modalImg) modalImg.style.display = 'none';
      if (modalDtr) modalDtr.style.display = 'block';
    } else if (isImg) {
      if (modalIframe) modalIframe.style.display = 'none';
      if (modalDtr) modalDtr.style.display = 'none';
      if (modalImg) {
        modalImg.src = file;
        modalImg.style.display = 'block';
      }
    } else {
      if (modalImg) modalImg.style.display = 'none';
      if (modalDtr) modalDtr.style.display = 'none';
      if (modalIframe) {
        modalIframe.src = file;
        modalIframe.style.display = 'block';
      }
    }

    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closePreview() {
    if (!modal) return;
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    if (modalIframe) modalIframe.src = '';
    if (modalImg) modalImg.src = '';
    document.body.style.overflow = '';
  }

  previewBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-doc-title') || 'Document Preview';
      const file = btn.getAttribute('data-doc-file') || '';
      const desc = btn.getAttribute('data-doc-desc') || '';
      const isImg = btn.getAttribute('data-is-img') === 'true';
      openPreview(title, file, desc, isImg, false);
    });
  });

  dtrBtn?.addEventListener('click', () => {
    openPreview('Official Daily Time Record (DTR) Summary', '', 'Cumulative time record breakdown verified by Mr. Marlon A. Enriquez (System Administrator). Total: 486 verified hours across 15 consecutive weeks.', false, true);
  });

  closeBtn?.addEventListener('click', closePreview);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePreview();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      closePreview();
    }
  });
</script>

<style>
  .ark-ojt-banner {
    padding: 36px;
    margin-bottom: 40px;
    background: var(--ark-bg-card);
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 32px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .ark-banner-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .ark-banner-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--ark-text-bright);
    margin: 12px 0 8px;
    text-transform: uppercase;
  }

  .ark-banner-desc {
    font-size: 0.92rem;
    color: var(--ark-text-body);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .ark-banner-previews {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ark-ojt-stats-box {
    background: var(--ark-bg-surface);
    border: 1px solid var(--ark-border-subtle);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ark-stat-row {
    display: flex;
    flex-direction: column;
  }

  .ark-stat-val {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--ark-yellow);
    line-height: 1;
  }

  .ark-stat-lbl {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ark-text-muted);
    letter-spacing: 0.08em;
  }

  /* Weekly Reports Grid */
  .ark-weekly-reports-section, .ark-ojt-gallery-section {
    margin-top: 48px;
  }

  .ark-weekly-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
  }

  .ark-weekly-card {
    padding: 20px;
    background: var(--ark-bg-card);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ark-border-mid);
    transition: var(--ark-transition);
  }

  .ark-weekly-card:hover {
    border-color: var(--ark-yellow);
    transform: translateY(-2px);
  }

